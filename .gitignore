# Runtime state and logs
logs/
__pycache__/
*.pyc

# Generated on first run
icon_active.ico
icon_paused.ico

# Personal data. icon_layouts.json holds the NAME of every desktop item, which
# is often private - tax documents, medical files, client names. Never commit it.
icon_layouts.json
icons_backup*.json

# Machine-specific settings (hardware ids, editor path). config.example.json is
# the template; PhantomMonitor writes config.json itself on first run.
config.json
arrangement.json
arrangement_undo.json
config.json.bak
config.json.*

# Build output - the exe belongs in a GitHub Release, not in the repo
build/dist/
build/work/
build/*.spec

# Throwaway diagnostics with this machine's hardware ids baked in
watch_amp.py
time_it.py

# Release bodies are drafted locally and live on the release itself
RELEASE_NOTES_*.md

# Installer test logs
install.log

# Local working files - the session scaffolding and the working bug list.
# KNOWN_BUGS.md quotes this machine's pins and hardware ids out of config.json
# and arrangement.json, both ignored above for the same reason.
.claude/
CLAUDE.md
docs/TODO.md
docs/KNOWN_BUGS.md
docs/memory/
